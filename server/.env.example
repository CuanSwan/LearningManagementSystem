# Copy this file to .env and fill in what you need. .env is gitignored -
# never commit real secrets. Nothing here is required for local dev: with
# no .env at all, the server falls back to JSON-file storage under ./.data
# and sensible local defaults (see server/src/db/index.ts, index.ts).

# Port the API listens on. Default: 4000
PORT=4000

# Set to "production" to enable cross-origin session cookies (SameSite=None;
# Secure) - only needed when the client and server are on different domains,
# e.g. a deployed Netlify frontend + Render backend. Leave unset locally.
NODE_ENV=

# Required alongside NODE_ENV=production: the exact origin (scheme + host,
# no trailing slash) the client is served from, so CORS can be locked to it
# instead of reflecting any origin. e.g. https://your-app.netlify.app
CLIENT_ORIGIN=

# MongoDB connection string. Leave unset for local dev - the server falls
# back to JSON-file storage under DATA_DIR instead.
MONGODB_URI=

# Database name to use within that MongoDB cluster. Default: lms
MONGODB_DB=

# Directory for the JSON-file storage fallback (only used when MONGODB_URI
# is unset). Default: ./.data
DATA_DIR=
