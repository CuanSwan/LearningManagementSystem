{
  "name": "learning-management-system",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client",
    "prototype"
  ],
  "scripts": {
    "build:shared": "npm run build -w shared",
    "build:server": "npm run build -w server",
    "build:client": "npm run build -w client",
    "start:server": "npm start -w server",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "dev:prototype": "npm run dev -w prototype",
    "build:prototype": "npm run build:shared && npm run build -w prototype",
    "test": "npm run test -w shared && npm run test -w server && npm run test -w client"
  }
}
